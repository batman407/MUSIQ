# ============================================================
# MUSIQ OMR Backend — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Server port (Railway/Render inject PORT automatically)
PORT=3001

# Path to Audiveris binary (set in Dockerfile, override if needed)
AUDIVERIS_BIN=/usr/local/bin/audiveris

# Headless Java mode (required for containerized Audiveris)
JAVA_TOOL_OPTIONS=-Djava.awt.headless=true

# CORS origin — set to your production frontend URL
# Comma-separated for multiple origins
CORS_ORIGIN=https://musiq-sooty.vercel.app

# Node environment
NODE_ENV=production

# ============================================================
# Supabase Persistent Job Storage & Artifacts
# Required for job persistence across restarts, deploys & replicas
# ============================================================

# Supabase Project URL (Dashboard -> Project Settings -> API -> Project URL)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase Service Role Secret Key (SERVER-ONLY — NEVER expose to browser/Vite)
# (Dashboard -> Project Settings -> API -> Project API Keys -> service_role secret)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# Resource Limits
# ============================================================

# Maximum upload file size in MB
MAX_FILE_SIZE_MB=50

# Job cleanup interval in minutes (0 = no auto-cleanup)
JOB_CLEANUP_MINUTES=60

# Maximum concurrent OMR jobs
MAX_CONCURRENT_JOBS=3
